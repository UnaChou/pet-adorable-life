# MySQL 資料庫設定（對應 docker-compose.yml 預設值）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=pet_user
MYSQL_PASSWORD=pet_password
MYSQL_DATABASE=pet_adorable_life

# Ollama 端點（本機開發時可覆寫）
OLLAMA_URL=http://192.168.50.11:11434/api/generate

# Flask session secret（生產環境請設定為隨機長字串）
SECRET_KEY=change-me-in-production

# 電子郵件設定（忘記密碼功能）
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password  # 使用 App 密碼，不是一般登入密碼
MAIL_DEFAULT_SENDER=your-email@gmail.com
